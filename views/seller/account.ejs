<%- include('../partials/head') %>
<section class="stack">
  <h1>บัญชีของฉัน</h1>
  <div class="two">
    <form class="panel form" method="post" action="/seller/account/profile">
      <h2>ข้อมูลร้าน</h2>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="f" for="display_name"><span>นามปากกา / ชื่อร้าน</span><input id="display_name" name="display_name" minlength="2" maxlength="60" required value="<%= me.display_name %>"></label>
      <label class="f" for="email"><span>อีเมลที่ใช้เข้าสู่ระบบ</span><input id="email" value="<%= me.email %>" disabled></label>
      <label class="f" for="phone"><span>เบอร์โทร</span><input id="phone" name="phone" type="tel" value="<%= me.phone %>"></label>
      <div><button class="btn">บันทึกข้อมูลร้าน</button></div>
    </form>
    <form class="panel form" method="post" action="/seller/account/payout" id="payout">
      <h2>บัญชีรับเงิน</h2>
      <p class="hint">ระบบยังไม่เชื่อมธนาคาร แอดมินจะโอนให้ตามรอบและบันทึกในระบบ ข้อมูลนี้เห็นเฉพาะคุณและแอดมิน</p>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="f" for="payout_account"><span>พร้อมเพย์ หรือเลขบัญชี</span><input id="payout_account" name="payout_account" value="<%= me.payout_account %>"></label>
      <label class="f" for="payout_name"><span>ชื่อบัญชี</span><input id="payout_name" name="payout_name" value="<%= me.payout_name %>"></label>
      <label class="f" for="payout_bank"><span>ธนาคาร (ถ้าใช้เลขบัญชี)</span><input id="payout_bank" name="payout_bank" value="<%= me.payout_bank %>"></label>
      <div><button class="btn">บันทึกบัญชีรับเงิน</button></div>
    </form>
  </div>
  <% if (me.handmade_status === 'approved') { %>
  <form class="panel form" method="post" action="/seller/account/shipping" id="shipping">
    <h2>ค่าส่งและที่อยู่ผู้ส่ง (งาน handmade)</h2>
    <p class="hint">คิดค่าส่งต่อพัสดุของร้าน: ชิ้นแรก + ชิ้นต่อไปบวกเพิ่มต่อชิ้น และส่งฟรีเมื่อลูกค้าซื้อจากร้านคุณครบยอด (เว้นว่างถ้าไม่มีส่งฟรี) ค่าส่งทั้งหมดเป็นของร้าน ไม่หักค่าธรรมเนียม</p>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <div class="fgrid">
      <label class="f" for="ship_first"><span>ค่าส่งชิ้นแรก (บาท)</span><input id="ship_first" name="ship_first" type="number" min="0" max="1000" value="<%= me.ship_first %>"></label>
      <label class="f" for="ship_next"><span>ชิ้นต่อไปบวกเพิ่ม (บาท/ชิ้น)</span><input id="ship_next" name="ship_next" type="number" min="0" max="1000" value="<%= me.ship_next %>"></label>
      <label class="f" for="ship_free_over"><span>ส่งฟรีเมื่อซื้อครบ (บาท, ไม่บังคับ)</span><input id="ship_free_over" name="ship_free_over" type="number" min="1" value="<%= me.ship_free_over ?? '' %>" placeholder="ไม่มีส่งฟรี"></label>
    </div>
    <label class="f" for="ship_from"><span>ที่อยู่ผู้ส่ง (พิมพ์บนใบปะหน้า)</span><textarea id="ship_from" name="ship_from" maxlength="300" placeholder="บ้านเลขที่ ถนน ตำบล อำเภอ จังหวัด รหัสไปรษณีย์"><%= me.ship_from %></textarea></label>
    <div><button class="btn">บันทึกค่าส่ง</button></div>
  </form>
  <% } %>
  <form class="panel form half" method="post" action="/seller/password">
    <h2>เปลี่ยนรหัสผ่าน</h2>
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="f" for="current_password"><span>รหัสผ่านปัจจุบัน</span><input id="current_password" name="current_password" type="password" autocomplete="current-password" required></label>
    <div class="fgrid">
      <label class="f" for="new_password"><span>รหัสผ่านใหม่</span><input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="8" required></label>
      <label class="f" for="confirm"><span>ยืนยันรหัสผ่านใหม่</span><input id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required></label>
    </div>
    <div><button class="btn">เปลี่ยนรหัสผ่าน</button></div>
  </form>
  <p class="small muted">สมัครเมื่อ <%= C.dt(me.created_at) %></p>
</section>
<%- include('../partials/foot') %>
