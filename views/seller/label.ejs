<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ใบปะหน้า <%= s.code %></title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@400;600&display=swap" rel="stylesheet">
<style>
  /* Plain printable label: 100 × 150 mm, the common thermal-label size; fits on A4 too. */
  @page { size: 100mm 150mm; margin: 0; }
  body { margin: 0; font-family: 'IBM Plex Sans Thai', system-ui, sans-serif; color: #000; background: #eee; }
  .label { width: 100mm; min-height: 150mm; box-sizing: border-box; padding: 6mm; background: #fff; margin: 10mm auto; display: grid; gap: 4mm; align-content: start; border: 1px dashed #999; }
  .box { border: 1.5px solid #000; padding: 3mm; }
  .k { font-size: 9pt; color: #333; }
  .to b { font-size: 15pt; } .to .addr { font-size: 13pt; line-height: 1.35; } .to .tel { font-size: 13pt; font-weight: 600; }
  .from { font-size: 10pt; line-height: 1.35; }
  .code { font-size: 18pt; font-weight: 600; letter-spacing: .05em; text-align: center; border: 2px solid #000; padding: 2mm; }
  .items { font-size: 9pt; line-height: 1.4; margin: 0; padding-left: 4mm; }
  .paid { text-align: center; font-weight: 600; font-size: 11pt; }
  .bar { text-align: center; margin: 4mm 0; }
  .bar button { font: inherit; padding: 8px 18px; border-radius: 8px; border: 1px solid #333; background: #111; color: #fff; cursor: pointer; }
  @media print { body { background: #fff; } .label { margin: 0; border: 0; } .bar { display: none; } }
</style>
</head>
<body>
<div class="bar"><button onclick="window.print()">พิมพ์ใบปะหน้า</button></div>
<div class="label">
  <div class="box to">
    <div class="k">ผู้รับ</div>
    <b><%= s.ship_name %></b>
    <div class="tel">โทร <%= s.ship_phone %></div>
    <div class="addr"><%= s.ship_address %></div>
  </div>
  <div class="box from">
    <div class="k">ผู้ส่ง</div>
    <b><%= shop.display_name %></b><% if (shop.phone) { %> · โทร <%= shop.phone %><% } %><br>
    <%= shop.ship_from || 'ยังไม่ได้ตั้งที่อยู่ผู้ส่ง (ตั้งได้ที่ บัญชี → ค่าส่งและที่อยู่ผู้ส่ง)' %>
  </div>
  <div class="code">เลขออเดอร์ <%= s.code %></div>
  <div class="paid"><%= s.method === 'transfer' ? 'ชำระเงินแล้ว · ไม่ต้องเก็บเงินปลายทาง' : 'เก็บเงินปลายทาง ' + C.thb(s.items_total + s.ship_fee) %></div>
  <div>
    <div class="k">ในกล่อง (<%= s.items.reduce((a, i) => a + i.qty, 0) %> ชิ้น)</div>
    <ul class="items"><% for (const i of s.items) { %><li><%= i.title %> × <%= i.qty %><%= i.lines.length ? ' · ' + i.lines.map(l => l.value).join(' / ') : '' %></li><% } %></ul>
  </div>
</div>
</body>
</html>
