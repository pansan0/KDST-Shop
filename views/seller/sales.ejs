<%- include('../partials/head') %>
<section class="stack">
  <h1>ยอดขายและการรับเงิน</h1>
  <div class="kpis">
    <div class="kpi"><b><%= stats.units %></b><span>ชิ้นที่ขายได้ (ลูกค้าได้รับแล้ว)</span></div>
    <div class="kpi"><b><%= C.thb(stats.pending) %></b><span>รอปล่อย (ชำระแล้ว แต่ลูกค้ายังไม่ได้รับ)</span></div>
    <div class="kpi"><b><%= C.thb(stats.earned) %></b><span>รายได้ที่ปล่อยแล้วสะสม</span></div>
    <div class="kpi"><b><%= C.thb(stats.paid) %></b><span>โอนให้แล้ว</span></div>
    <div class="kpi accent"><b><%= C.thb(stats.balance) %></b><span>ถอนได้ · รอแอดมินโอน</span></div>
  </div>
  <div class="panel">
    <h2>รายการขาย</h2>
    <p class="hint">handmade: เงินเป็น "รอปล่อย" เมื่อแอดมินยืนยันการชำระ และ "ถอนได้" เมื่อลูกค้ากดได้รับ หรือครบ <%= settings.release_days %> วันหลังส่งโดยไม่มีการแจ้งปัญหา · หนังสือ: นับเมื่อส่งถึงแล้ว · หนังสือ: ราคา × <%= C.ROYALTY * 100 %>% − ค่าพิมพ์ · handmade: ราคารวมตัวเลือก − ค่าธรรมเนียม <%= fee %>% + ค่าส่งที่คุณตั้ง</p>
    <% if (!items.length) { %><div class="empty">ยังไม่มีคำสั่งซื้อ</div><% } else { %>
    <div class="tbl-wrap"><table>
      <thead><tr><th>วันที่</th><th>เลขที่</th><th>สินค้า</th><th class="r">จำนวน</th><th>สถานะพัสดุ</th><th class="r">คุณได้</th></tr></thead>
      <tbody><% for (const i of items) { const [t, c] = C.shipStatus(i); const counted = ['delivered', 'released'].includes(i.status); const pending = i.method === 'transfer' && ['preparing', 'shipped', 'problem'].includes(i.status); %>
        <tr><td class="small"><%= C.dt(i.created_at) %></td><td class="num small"><%= i.code %></td>
          <td><%= i.title %><%- include('../partials/lines', { lines: JSON.parse(i.options) }) %></td><td class="num r"><%= i.qty %></td><td><%- pill(t, c) %></td>
          <td class="num r <%= counted ? '' : 'muted' %>"><%= C.thb(i.qty * i.earn_unit) %><%= counted ? '' : pending ? ' (รอปล่อย)' : ' (ไม่นับ)' %></td></tr>
      <% } %></tbody>
    </table></div>
    <% } %>
  </div>
  <div class="panel">
    <div class="row between head-row"><h2>ประวัติการรับเงิน</h2><a class="small" href="/seller/account#payout">แก้ไขบัญชีรับเงิน</a></div>
    <% if (!payouts.length) { %><div class="empty">ยังไม่มีการโอน</div><% } else { %>
    <table><thead><tr><th>วันที่</th><th class="r">ยอด</th><th>อ้างอิง</th><th>สลิป</th></tr></thead>
      <tbody><% for (const p of payouts) { %><tr><td><%= C.dt(p.created_at) %></td><td class="num r"><%= C.thb(p.amount) %></td><td class="small"><%= p.ref %> <span class="muted"><%= p.note %></span></td><td class="small"><% if (p.slip_file) { %><a href="/files/payout/<%= p.id %>" target="_blank" rel="noopener">ดูสลิป</a><% } else { %><span class="muted">–</span><% } %></td></tr><% } %></tbody></table>
    <% } %>
  </div>
</section>
<%- include('../partials/foot') %>
