<%- include('../partials/head') %>
<% const late = s => ['preparing', 'placed', 'in_production'].includes(s.status) && Date.now() > s.due_at; %>
<section class="stack">
  <div><h1>ออเดอร์ที่ต้องจัดส่ง</h1>
    <p class="muted lead">ลูกค้าโอนเงินให้ <%= settings.store_name %> แล้ว ร้านเตรียมสินค้าตามตัวเลือกที่ลูกค้าเลือก แพ็ก แล้วส่งเองกับขนส่งที่สะดวก จากนั้นกรอกชื่อขนส่งกับเลขพัสดุก่อนวันกำหนดส่ง
      เงินจะเข้า "ถอนได้" เมื่อลูกค้ากดได้รับ หรือครบ <%= settings.release_days %> วันหลังส่งโดยไม่มีการแจ้งปัญหา · ถ้าเลยกำหนดส่ง <%= settings.auto_cancel_days %> วัน ระบบจะยกเลิกและคืนเงินลูกค้า</p></div>
  <nav class="filters" aria-label="กรอง">
    <% for (const [k, [t]] of Object.entries(tabs)) { %><a class="chip" href="/seller/orders?tab=<%= k %>" <%- tab === k ? 'aria-current="true"' : '' %>><%= t %><%= counts[k] && !['done', 'all'].includes(k) ? ' (' + counts[k] + ')' : '' %></a><% } %>
  </nav>
  <% if (!ships.length) { %><div class="panel empty">ไม่มีพัสดุในหมวดนี้</div><% } %>
  <% for (const s of ships) { const [st, cls] = C.shipStatus(s); %>
  <div class="panel stack">
    <div class="row between">
      <div><b class="num"><%= s.code %></b> <span class="small muted">สั่งเมื่อ <%= C.dt(s.created_at) %><%= s.paid_at ? ' · ชำระเมื่อ ' + C.dt(s.paid_at) : '' %></span>
        <% if (['preparing', 'placed', 'in_production'].includes(s.status)) { %>
        <div class="small <%= late(s) ? 'bad-text' : '' %>"><%= late(s) ? '⚠ เลยกำหนดส่งแล้ว · ต้องส่งภายใน' : 'ต้องส่งภายใน' %> <%= C.day(s.due_at) %></div>
        <% } else if (s.status === 'awaiting_payment') { %><div class="small muted">รอแอดมินยืนยันการชำระ ยังไม่ต้องเตรียมสินค้า</div><% } %>
      </div>
      <%- pill(st, cls) %>
    </div>
    <div class="two">
      <div class="stack-sm">
        <h3>รายการสินค้า</h3>
        <% for (const i of s.items) { %>
        <div class="prodsheet"><b><%= i.title %> × <%= i.qty %></b><%- include('../partials/lines', { lines: i.lines }) %>
          <% if (i.note) { %><div class="small"><span class="muted">ข้อความสั่งทำพิเศษ:</span> <b><%= i.note %></b></div><% } %></div>
        <% } %>
        <div class="small muted">ยอดพัสดุ <span class="num"><%= C.thb(s.items_total + s.ship_fee) %></span> (สินค้า <%= C.thb(s.items_total) %> + ค่าส่ง <%= C.thb(s.ship_fee) %>) · <%= s.method === 'transfer' ? 'ลูกค้าโอนแล้ว ไม่ต้องเก็บเงินปลายทาง' : 'เก็บเงินปลายทาง (ออเดอร์ระบบเดิม)' %></div>
      </div>
      <div class="stack-sm">
        <h3>ผู้รับ</h3>
        <% if (s.showBuyer) { %>
          <div><b><%= s.ship_name %></b> · <span class="num"><%= s.ship_phone %></span><br><span class="muted"><%= s.ship_address %></span></div>
        <% } else if (s.status === 'awaiting_payment') { %><div class="small muted">แสดงชื่อที่อยู่เมื่อลูกค้าชำระเงินแล้ว</div>
        <% } else { %><div class="small muted">ซ่อนข้อมูลผู้ซื้อแล้ว (PDPA: แสดงเฉพาะระหว่างจัดส่งและ 30 วันหลังได้รับ)</div><% } %>
        <% if (s.tracking) { %><div class="small row"><%- include('../partials/carrier', { carrier: s.carrier }) %> <b class="num"><%= s.tracking %></b> · ส่งเมื่อ <%= C.dt(s.shipped_at) %></div><% } %>
        <% if (s.note && ['cancelled', 'returned'].includes(s.status)) { %><div class="small muted"><%= s.note %></div><% } %>
        <% if (s.auto_note) { %><div class="small muted"><%= s.auto_note %></div><% } %>
        <% for (const d of s.disputes) { const [dt, dc] = C.DISPUTE_STATUS[d.status]; %>
        <div class="claim small"><div class="row between"><b>ลูกค้าแจ้ง: <%= C.PROBLEM_KINDS[d.kind] %></b><%- pill(dt, dc) %></div><p class="prose"><%= d.detail %></p>
          <% if (d.imgs.length) { %><div class="previews"><% d.imgs.forEach((_, i) => { %><a href="/files/dispute/<%= d.id %>/<%= i %>" target="_blank" rel="noopener"><img src="/files/dispute/<%= d.id %>/<%= i %>" alt="รูปปัญหา <%= i + 1 %>"></a><% }) %></div><% } %>
          <% if (d.decision_note) { %><div>ผลจากแอดมิน: <%= d.decision_note %></div><% } %></div>
        <% } %>
      </div>
    </div>
    <% const hidden = `<input type="hidden" name="_csrf" value="${csrf}"><input type="hidden" name="tab" value="${tab}">`; %>
    <% if (s.status === 'preparing' || (s.flow === 'legacy' && s.status === 'in_production')) { %>
    <form class="shipform" method="post" action="/seller/shipments/<%= s.id %>/ship"><%- hidden %>
      <%- include('../partials/carrier-pick', { id: s.id }) %>
      <label class="f" for="tr<%= s.id %>"><span>เลขพัสดุ</span><input id="tr<%= s.id %>" name="tracking" maxlength="60" required></label>
      <button class="btn primary">บันทึกการจัดส่ง</button>
    </form>
    <% } %>
    <div class="row actions">
      <% if (s.flow === 'legacy' && s.status === 'placed') { %>
        <form method="post" action="/seller/shipments/<%= s.id %>/start"><%- hidden %><button class="btn primary">รับงาน · เริ่มทำ</button></form>
      <% } %>
      <% if (['preparing', 'shipped', 'problem', 'placed', 'in_production'].includes(s.status)) { %>
        <a class="btn sm" href="/seller/shipments/<%= s.id %>/label" target="_blank" rel="noopener">พิมพ์ใบปะหน้า</a>
      <% } %>
      <% if (['preparing', 'placed', 'in_production'].includes(s.status)) { %>
        <form class="inline" method="post" action="/seller/shipments/<%= s.id %>/cancel" data-confirm="ยกเลิกพัสดุนี้? <%= s.method === 'transfer' ? 'ระบบจะคืนเงินลูกค้า และ' : '' %>นับในอัตราร้านยกเลิกเอง"><%- hidden %><input name="note" placeholder="เหตุผล (ลูกค้าจะเห็น)" aria-label="เหตุผลที่ยกเลิก" required minlength="3"><button class="btn sm ghost">ยกเลิก</button></form>
      <% } %>
    </div>
  </div>
  <% } %>
</section>
<%- include('../partials/foot', { scripts: ['ship-form'] }) %>
