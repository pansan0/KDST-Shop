<%- include('../partials/head') %>
<section class="stack">
  <div><span class="eyebrow">ระบบหลังร้าน</span><h1>ภาพรวม</h1></div>
  <div class="kpis">
    <a class="kpi link <%= badges.products ? 'alert' : '' %>" href="/admin/products"><b><%= badges.products %></b><span>สินค้ารอตรวจ</span></a>
    <a class="kpi link <%= badges.orders ? 'alert' : '' %>" href="/admin/orders?tab=platform"><b><%= badges.orders %></b><span>พัสดุหนังสือที่ต้องพิมพ์/ส่ง</span></a>
    <a class="kpi link" href="/admin/orders?tab=cod"><b><%= k.awaiting_cod %></b><span>รอยืนยันเก็บเงินปลายทาง</span></a>
    <a class="kpi link <%= k.late ? 'alert' : '' %>" href="/admin/orders?tab=late"><b><%= k.late %></b><span>พัสดุร้าน handmade เลยกำหนด</span></a>
    <a class="kpi link <%= badges.apps ? 'alert' : '' %>" href="/admin/sellers#apps"><b><%= badges.apps %></b><span>ใบสมัคร handmade</span></a>
  </div>
  <div class="kpis">
    <div class="kpi"><b><%= C.thb(k.revenue) %></b><span>ยอดขายที่เก็บเงินแล้ว (ไม่รวมค่าส่ง)</span></div>
    <a class="kpi link" href="/admin/payouts"><b><%= C.thb(owed) %></b><span>ค้างจ่ายผู้ขาย</span></a>
    <a class="kpi link" href="/admin/sellers"><b><%= k.sellers %></b><span>ผู้ขาย · <%= k.live %> สินค้าวางขาย</span></a>
    <a class="kpi link" href="/admin/buyers"><b><%= k.buyers %></b><span>ผู้ซื้อ</span></a>
  </div>
  <div class="two">
    <div class="panel">
      <div class="row between head-row"><h2>สินค้ารอตรวจ (เก่าสุดก่อน)</h2><a class="small" href="/admin/products">ทั้งหมด</a></div>
      <% if (!products.length) { %><div class="empty">ไม่มีงานค้างตรวจ</div><% } else { %>
      <ul class="list-rows"><% for (const p of products) { %>
        <li><a class="bookcell" href="/admin/products/<%= p.id %>"><img class="thumb" src="/files/cover/<%= p.id %>" alt=""><div><b><%= p.title %></b><div class="small muted"><%= C.KINDS[p.kind] %> · <%= p.shop %> · ส่งเมื่อ <%= C.dt(p.submitted_at) %><%= p.rev > 1 ? ' · ครั้งที่ ' + p.rev : '' %></div></div></a></li>
      <% } %></ul><% } %>
    </div>
    <div class="panel">
      <div class="row between head-row"><h2>ใบสมัคร handmade</h2><a class="small" href="/admin/sellers#apps">ทั้งหมด</a></div>
      <% if (!apps.length) { %><div class="empty">ไม่มีใบสมัครค้าง</div><% } else { %>
      <ul class="list-rows"><% for (const a of apps) { %>
        <li><a href="/admin/sellers#app<%= a.id %>"><b><%= a.shop %></b><div class="small muted"><%= C.dt(a.created_at) %></div></a></li>
      <% } %></ul><% } %>
    </div>
  </div>
</section>
<%- include('../partials/foot') %>
