<%- include('../partials/head') %>
<% const backUrl = '/admin/orders?tab=' + tab; const hidden = `<input type="hidden" name="_csrf" value="${csrf}"><input type="hidden" name="back" value="${backUrl}">`; %>
<section class="stack">
  <div><h1>คำสั่งซื้อ</h1><p class="muted lead">คำสั่งซื้อแยกเป็นพัสดุ: หนังสือ KDP ทุกเล่ม Inkfold พิมพ์และส่งเอง งาน handmade ร้านส่งเองผ่านบัญชีเก็บเงินปลายทางของ Inkfold แอดมินยืนยัน "ส่งถึงและเก็บเงินแล้ว" เมื่อขนส่งโอนยอด COD เข้ามา รายได้จึงจะเข้าบัญชีผู้ขาย</p></div>
  <nav class="filters" aria-label="กรอง">
    <% for (const [k, [t]] of Object.entries(tabs)) { %><a class="chip" href="/admin/orders?tab=<%= k %>" <%- tab === k ? 'aria-current="true"' : '' %>><%= t %><%= counts[k] && k !== 'all' && k !== 'done' ? ' (' + counts[k] + ')' : '' %></a><% } %>
  </nav>
  <div class="panel">
    <% if (!ships.length) { %><div class="empty">ไม่มีพัสดุในหมวดนี้</div><% } else { %>
    <div class="tbl-wrap"><table>
      <thead><tr><th>พัสดุ</th><th>สินค้า</th><th>ผู้รับ</th><th class="r">เก็บปลายทาง</th><th>สถานะ</th><th>จัดการ</th></tr></thead>
      <tbody><% for (const s of ships) { const [t, c] = C.shipStatus(s); const late = ['placed', 'in_production'].includes(s.status) && Date.now() > s.due_at; %>
        <tr>
          <td class="small"><b class="num"><%= s.code %></b><br><%= s.fulfilled_by === 'platform' ? 'Inkfold' : 'ร้าน ' + s.shop %><br><span class="<%= late ? '' : 'muted' %>"><%= late ? '⚠ เลยกำหนด ' : 'กำหนดส่ง ' %><%= C.day(s.due_at) %></span></td>
          <td><div class="ship-items"><% for (const i of s.items) { %><div class="ship-item"><a class="order-thumb" href="/admin/products/<%= i.product_id %>" title="ดูสินค้า"><img src="/files/cover/<%= i.product_id %>" alt="" loading="lazy"></a><div><b><%= i.title %></b> × <%= i.qty %><%- include('../partials/lines', { lines: i.lines }) %></div></div><% } %></div></td>
          <td class="small"><%= s.ship_name %><br><span class="num"><%= s.ship_phone %></span><br><span class="muted"><%= s.ship_address %></span><br><span class="muted">บัญชี: <%= s.buyer %></span></td>
          <td class="num r"><%= C.thb(s.items_total + s.ship_fee) %></td>
          <td><%- pill(t, c) %><% if (s.tracking) { %><div class="small num"><%= s.tracking %></div><% } %><% if (s.note && ['cancelled', 'returned'].includes(s.status)) { %><div class="small muted"><%= s.note %></div><% } %></td>
          <td><div class="stack-sm actions-col">
            <% if (s.status === 'placed') { %>
              <form method="post" action="/admin/shipments/<%= s.id %>/start"><%- hidden %><button class="btn sm good"><%= s.fulfilled_by === 'platform' ? 'ยืนยัน · ส่งเข้าคิวพิมพ์' : 'รับงานแทนร้าน' %></button></form>
            <% } else if (s.status === 'in_production') { %>
              <% for (const i of s.items) { %><% if (i.pdf_file) { %><a class="btn sm" href="/files/pdf/<%= i.product_id %>" target="_blank" rel="noopener">เนื้อใน: <%= i.title %></a><% } %><% if (i.cover_pdf) { %><a class="btn sm" href="/files/cover-pdf/<%= i.product_id %>" target="_blank" rel="noopener">ปก PDF: <%= i.title %></a><% } %><% } %>
              <form class="inline" method="post" action="/admin/shipments/<%= s.id %>/ship"><%- hidden %><input name="tracking" placeholder="เลขพัสดุ" aria-label="เลขพัสดุ" required><button class="btn sm primary">จัดส่งแล้ว</button></form>
            <% } else if (s.status === 'shipped') { %>
              <form method="post" action="/admin/shipments/<%= s.id %>/deliver"><%- hidden %><button class="btn sm good">ส่งถึง · เก็บเงินแล้ว</button></form>
              <form class="inline" method="post" action="/admin/shipments/<%= s.id %>/return" data-confirm="บันทึกว่าผู้รับปฏิเสธรับพัสดุ?"><%- hidden %><input name="note" placeholder="หมายเหตุ (ไม่บังคับ)" aria-label="หมายเหตุตีกลับ"><button class="btn sm bad">ตีกลับ</button></form>
            <% } %>
            <% if (['placed', 'in_production'].includes(s.status)) { %>
              <form class="inline" method="post" action="/admin/shipments/<%= s.id %>/cancel" data-confirm="ยกเลิกพัสดุนี้?"><%- hidden %><input name="note" placeholder="เหตุผล" aria-label="เหตุผลที่ยกเลิก" required minlength="3"><button class="btn sm ghost">ยกเลิก</button></form>
            <% } %>
          </div></td>
        </tr>
      <% } %></tbody>
    </table></div>
    <% } %>
  </div>
</section>
<%- include('../partials/foot') %>
