<%- include('../partials/head') %>
<section class="stack narrow-col">
  <% if (isNew) { %>
  <div class="done">
    <svg width="52" height="52" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="11" fill="currentColor"/><path d="m7 12.5 3.2 3.2L17 9" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    <h1>สั่งซื้อเรียบร้อย</h1>
    <p>เลขคำสั่งซื้อของคุณ</p>
    <div class="done-code num"><%= order.code %></div>
    <p class="small muted">เตรียมเงินสด <b class="num"><%= C.thb(order.total) %></b> ไว้จ่ายเมื่อได้รับของ<%= order.shipments.length > 1 ? ` (แยกจ่ายตามพัสดุ ${order.shipments.length} กล่อง)` : '' %></p>
  </div>
  <% } else { %>
  <div class="row between">
    <div><span class="eyebrow">คำสั่งซื้อ</span><h1 class="num"><%= order.code %></h1><div class="small muted"><%= C.dt(order.created_at) %></div></div>
    <%- pill(order.state[0], order.state[1]) %>
  </div>
  <% } %>

  <% if (order.shipments.some(s => ['placed', 'in_production', 'shipped'].includes(s.status))) { const [a, b] = C.waitRange(order.created_at); %>
  <div class="wait-note" role="note"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 7v5l3 2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><div><b>คาดว่าจะได้รับ <%= C.day(a) %> – <%= C.day(b) %></b><span><%= C.WAIT.text %> นับจากวันสั่ง</span></div></div>
  <% } %>
  <% order.shipments.forEach((s, n) => { const [st, cls] = C.shipStatus(s); const step = C.SHIP_STEP[s.status]; %>
  <div class="panel stack">
    <div class="row between">
      <div><b>พัสดุ <%= n + 1 %> · <%= s.fulfilled_by === 'platform' ? 'ส่งโดย Inkfold' : 'ส่งโดยร้าน ' + s.shop %></b>
        <div class="small muted">เก็บเงินปลายทาง <span class="num"><%= C.thb(s.items_total + s.ship_fee) %></span> (รวมค่าส่ง <%= C.thb(s.ship_fee) %>)</div></div>
      <%- pill(st, cls) %>
    </div>
    <% if (!['cancelled', 'returned'].includes(s.status)) { %>
    <ol class="track-steps" aria-label="ขั้นตอนพัสดุ <%= n + 1 %>">
      <% ['รับคำสั่งซื้อ', s.fulfilled_by === 'platform' ? 'กำลังพิมพ์' : 'กำลังทำ', 'จัดส่งแล้ว', 'ได้รับสินค้า'].forEach((t, i) => { %><li class="<%= step > i ? 'on' : '' %>"><span class="dot"></span><%= t %></li><% }) %>
    </ol>
    <% } %>
    <% if (s.note && ['cancelled', 'returned'].includes(s.status)) { %><div class="flash bad small"><%= s.note %></div><% } %>
    <% if (s.tracking) { %><div class="paybox"><span class="small muted">เลขพัสดุ</span><b class="num"><%= s.tracking %></b></div><% } %>
    <% if (C.OPEN_SHIP.includes(s.status) && s.status !== 'shipped') { %><p class="small muted">ร้านต้องส่งพัสดุออกภายใน <%= C.day(s.due_at) %></p><% } %>
    <ul class="list-rows">
      <% for (const i of s.items) { %>
      <li class="cart-row">
        <a href="/item/<%= i.product_id %>"><img class="cart-img" src="/files/cover/<%= i.product_id %>" alt=""></a>
        <div class="stack-sm"><span><%= i.title %> × <%= i.qty %></span><%- include('../partials/lines', { lines: i.lines }) %></div>
        <span class="num"><%= C.thb(i.unit_price * i.qty) %></span>
      </li>
      <% } %>
    </ul>
    <% if (s.status === 'placed') { %>
    <form method="post" action="/account/shipments/<%= s.id %>/cancel" data-confirm="ยกเลิกพัสดุนี้?">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost">ยกเลิกพัสดุนี้</button>
    </form>
    <% } %>
  </div>
  <% }) %>

  <dl class="pdp-specs">
    <dt>ส่งถึง</dt><dd><%= order.ship_name %> · <span class="num"><%= order.ship_phone %></span><br><span class="muted"><%= order.ship_address %></span></dd>
    <dt>ยอดรวม</dt><dd class="num"><b><%= C.thb(order.total) %></b> <span class="muted">(สินค้า <%= C.thb(order.items_total) %> + ค่าส่ง <%= C.thb(order.ship_total) %>)</span></dd>
    <dt>ชำระเงิน</dt><dd>เก็บเงินปลายทาง</dd>
  </dl>
  <div class="row">
    <a class="btn" href="/account/orders">คำสั่งซื้อทั้งหมด</a>
    <a class="btn ghost" href="/">เลือกสินค้าต่อ</a>
  </div>
</section>
<%- include('../partials/foot') %>
