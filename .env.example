# คัดลอกเป็น .env แล้วแก้ค่าก่อนใช้งานจริง
PORT=3000

# สุ่มค่ายาว ๆ เช่น: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ตั้งเป็น 1 เมื่อรันหลัง HTTPS (reverse proxy) เพื่อให้คุกกี้ส่งเฉพาะ HTTPS
COOKIE_SECURE=0

# แอดมินคนแรก สร้างอัตโนมัติตอนรันครั้งแรก (เปลี่ยนรหัสผ่านทันทีในหน้า ตั้งค่า)
ADMIN_EMAIL=admin@inkfold.local
ADMIN_PASSWORD=admin12345

# รหัสเชิญสำหรับสมัครแอดมินเพิ่มที่ /admin/register (เว้นว่าง = ปิดรับสมัครแอดมิน)
ADMIN_INVITE_CODE=

# ใส่ข้อมูลตัวอย่าง (ผู้ขาย demo@seller.local / seller12345) ตั้งเป็น 0 เพื่อปิด
SEED_DEMO=1

# ที่เก็บฐานข้อมูลและไฟล์อัปโหลด
DATA_DIR=storage
MAX_PDF_MB=200
MAX_IMAGE_MB=20
